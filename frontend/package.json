{
  "name": "prompt-archive",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "doctor": "npm run doctor:app --prefix .. -- --project frontend --human",
    "doctor:strict": "npm run doctor:app --prefix .. -- --project frontend --strict",
    "doctor:json": "npm run doctor:app --prefix .. -- --project frontend --json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@suite/ui": "file:./vendor/@suite/ui",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.69.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
