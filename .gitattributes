* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.avif binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
*.sqlite3 binary
# Installer binaries are stored in Git LFS (GitHub 100MB limit)
release/*.exe filter=lfs diff=lfs merge=lfs -text
